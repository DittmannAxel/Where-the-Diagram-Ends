# Reference only: the application does not load this file automatically.
# Never add tokens, PEM private keys, client secrets, or a populated .env file to Git.

# Local, no-cloud MCP demo.
QAM_GRAPH_ADAPTER=local
QAM_GRAPH_JSON_PATH=.artifacts/graph.json
QAM_CONTENT_ADAPTER=local
QAM_MARKDOWN_ROOT=knowledge
QAM_TRANSPORT=http
QAM_HTTP_HOST=127.0.0.1
QAM_HTTP_PORT=3000
QAM_HTTP_PATH=/mcp
QAM_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
QAM_HTTP_ALLOWED_ORIGINS=127.0.0.1,localhost
QAM_HTTP_AUTH_MODE=none
QAM_ENABLE_PROPOSALS=false
QAM_ADAPTER_TIMEOUT_MS=15000

# Optional local provenance assertions. Replace all placeholders together with
# values from one generated manifest; a mismatch intentionally fails closed.
# QAM_SOURCE_REPOSITORY=https://github.example.com/organization/repository
# QAM_EXPECTED_PROJECTION_ID=urn:qam:projection:<64-lowercase-hex>
# QAM_EXPECTED_COMMIT_SHA=<full-40-or-64-character-lowercase-git-object-id>

# Azure Container App runtime values are injected by Bicep. They are shown here
# only to document the non-secret interface; do not use a local .env file as the
# production configuration source.
# QAM_GRAPH_ADAPTER=fabric-gql
# QAM_FABRIC_WORKSPACE_ID=<fabric-workspace-uuid>
# QAM_FABRIC_GRAPH_MODEL_ID=<fabric-graph-model-uuid>
# QAM_FABRIC_API_URL=https://api.fabric.microsoft.com
# QAM_FABRIC_TOKEN_SCOPE=https://api.fabric.microsoft.com/.default
# QAM_FABRIC_MAX_NODES=10000
# QAM_FABRIC_MAX_EDGES=50000
# QAM_FABRIC_SNAPSHOT_TTL_MS=60000
# QAM_AZURE_CLIENT_ID=<container-runtime-uami-client-id>
# QAM_CONTENT_ADAPTER=github
# QAM_GITHUB_REPOSITORY=organization/repository
# QAM_GITHUB_AUTH_MODE=app
# QAM_GITHUB_APP_ID=<decimal-app-id>
# QAM_GITHUB_INSTALLATION_ID=<decimal-installation-id>
# QAM_GITHUB_API_URL=https://api.github.com
# QAM_GITHUB_WEB_URL=https://github.com
# QAM_HTTP_HOST=0.0.0.0
# QAM_HTTP_PORT=3000
# QAM_HTTP_PATH=/mcp
# QAM_HTTP_AUTH_MODE=trusted-header
# QAM_TRUSTED_IDENTITY_HEADER=x-ms-client-principal-id
# QAM_HTTP_ALLOWED_HOSTS=<container-app-fqdn>,localhost,127.0.0.1
# QAM_HTTP_ALLOWED_ORIGINS=<container-app-fqdn>

# The GitHub App PEM is injected into QAM_GITHUB_PRIVATE_KEY through a Container
# Apps Key Vault reference. Never place QAM_GITHUB_PRIVATE_KEY or QAM_GITHUB_TOKEN
# in this file. Token mode is an explicit fallback, not the recommended path.

# Non-secret inputs used by the Azure/Fabric deployment helpers.
# AZURE_SUBSCRIPTION_ID=<subscription-uuid>
# AZURE_RESOURCE_GROUP=<resource-group-name>
# AZURE_LOCATION=<azure-region>
# AZURE_PRINCIPAL_ID=<github-oidc-deployment-principal-object-id>
# QAM_ENVIRONMENT=dev
# QAM_IMAGE_DIGEST=sha256:<64-lowercase-hex>
# QAM_MCP_API_CLIENT_ID=<mcp-api-application-client-id>
# QAM_ALLOWED_CLIENT_APPLICATION_IDS=<published-agent-application-client-id>
# QAM_ALLOWED_PRINCIPAL_IDS=<published-agent-application-principal-id>
# QAM_GITHUB_PRIVATE_KEY_SECRET_URI=https://<vault>.vault.azure.net/secrets/<secret-name>
# QAM_FABRIC_LAKEHOUSE_ID=<fabric-lakehouse-uuid>
# QAM_FABRIC_NOTEBOOK_ID=<fabric-notebook-uuid>

# Non-secret Microsoft Foundry Agent Application inputs. Management and smoke
# commands authenticate with DefaultAzureCredential; no model/API key is used.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# FOUNDRY_MODEL_DEPLOYMENT_NAME=<tool-capable-model-deployment>
# QAM_FOUNDRY_AGENT_NAME=qam-knowledge-agent
# QAM_FOUNDRY_APPLICATION_NAME=qam-knowledge-application
# QAM_FOUNDRY_DEPLOYMENT_NAME=qam-managed-deployment
# QAM_FOUNDRY_CONNECTION_NAME=qam-mcp-project-identity
# QAM_MCP_URL=https://<container-app-fqdn>/mcp
# QAM_ALLOWED_MCP_HOST=<container-app-fqdn>
# QAM_MCP_AUDIENCE=api://<mcp-api-application-client-id>
# QAM_CONTAINER_APP_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.App/containerApps/<planned-app-name>
