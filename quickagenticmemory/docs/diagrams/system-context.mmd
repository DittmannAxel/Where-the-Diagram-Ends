architecture-beta

    group github(cloud)[GitHub Enterprise]
    group azure(azure:subscriptions)[Microsoft Azure]
    group foundry(azure:ai-studio)[Microsoft Foundry] in azure

    service wiki(disk)[Versioned .md Files] in github
    service pipeline(server)[Projector] in github
    service lake(database)[Fabric OneLake] in azure
    service graph(database)[Fabric Graph] in azure
    service agent(azure:ai-studio)[Agent Application] in foundry
    service appid(azure:managed-identities)[Application Identity] in foundry
    service projectid(azure:managed-identities)[Project Identity] in foundry
    service mcp(azure:worker-container-app)[MCP Gateway] in azure

    wiki:B --> T:pipeline
    pipeline:R --> L:lake
    lake:R --> L:graph
    agent:R --> L:appid
    agent:B --> T:projectid
    projectid:R --> L:mcp
    mcp:B --> T:graph
    mcp:L --> R:wiki
